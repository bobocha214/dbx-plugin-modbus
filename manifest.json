{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.github.yuzhi.everlink",
  "name": "EverLink",
  "version": "0.1.0",
  "publisher": "yuzhi",
  "description": "Read and write Modbus TCP data from industrial devices.",
  "icon": "assets/plugin.svg",
  "homepage": "https://dbxio.com/cn/docs/plugin-development",
  "engines": {
    "dbx": ">=0.5.68",
    "host_api": "1"
  },
  "permissions": [
    "host.events",
    "host.storage"
  ],
  "entrypoints": {
    "backend": {
      "protocol_versions": [
        1
      ],
      "transport": "stdio-jsonl",
      "executable": "bin/dbx-plugin-everlink"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.github.yuzhi.everlink.modbus",
      "label": "Modbus TCP",
      "icon": "assets/plugin.svg",
      "database_type": "modbus-tcp",
      "description": "Connect to a Modbus TCP server such as a PLC, gateway or remote IO coupler.",
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "binding": "name",
          "default": "Modbus device",
          "required": true
        },
        {
          "key": "host",
          "label": "Host",
          "type": "text",
          "binding": "host",
          "default": "192.168.1.10",
          "required": false
        },
        {
          "key": "port",
          "label": "Port",
          "type": "number",
          "binding": "port",
          "default": 502,
          "required": false
        },
        {
          "key": "unit_id",
          "label": "Unit id (slave address)",
          "type": "number",
          "binding": "config",
          "default": 1
        },
        {
          "key": "timeout_ms",
          "label": "Request timeout (ms)",
          "type": "number",
          "binding": "config",
          "default": 3000
        }
      ],
      "workbench": "io.github.yuzhi.everlink.modbus.workbench",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ]
    },
    {
      "type": "workbench",
      "id": "io.github.yuzhi.everlink.modbus.workbench",
      "label": "Modbus TCP workbench",
      "description": "Register table with periodic polling and guarded writes.",
      "icon": "assets/plugin.svg",
      "ai": {
        "recommendations": [
          {
            "id": "explain-registers",
            "label": "Explain this register table",
            "prompt": "Explain what each entry in the current Modbus register table represents and point out overlapping or unreadable address ranges.",
            "order": 10
          },
          {
            "id": "diagnose-failures",
            "label": "Diagnose failing addresses",
            "prompt": "Use the errors shown in the workbench to explain which Modbus addresses failed and the most likely cause (illegal address, data type or byte order).",
            "order": 20
          }
        ]
      }
    },
    {
      "type": "mcp",
      "id": "io.github.yuzhi.everlink.mcp",
      "description": "Read-only Modbus TCP tools for the DBX AI assistant.",
      "ai_tools": true,
      "external_tools": false
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "EverLink",
      "description": "从工业设备读取和写入 Modbus TCP 数据。",
      "contributions": {
        "io.github.yuzhi.everlink.modbus": {
          "label": "Modbus TCP",
          "description": "连接 Modbus TCP 服务端，例如 PLC、网关或远程 IO。",
          "fields": {
            "display_name": {
              "label": "连接名称"
            },
            "host": {
              "label": "主机地址"
            },
            "port": {
              "label": "端口"
            },
            "unit_id": {
              "label": "单元号（从站地址）"
            },
            "timeout_ms": {
              "label": "请求超时（毫秒）"
            }
          }
        },
        "io.github.yuzhi.everlink.modbus.workbench": {
          "label": "Modbus TCP 工作台",
          "description": "寄存器表、周期轮询与带二次确认的写入。"
        }
      }
    }
  }
}
